# 3DentAI Backend Configuration

# FastAPI Settings
PROJECT_NAME="3DentAI API"
VERSION="1.0.0"
API_STR="/api/v1"
ENVIRONMENT="development"  # development, staging, production

# Server Settings
HOST="0.0.0.0"
PORT=8000

# Security (JWT)
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY="your-super-secret-jwt-signing-key-for-dental-imaging-platform"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Supabase Configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-role-key"

# Storage Settings
# These buckets must exist in Supabase storage or will be created
BUCKET_PANO_IMAGES="panoramic-images"
BUCKET_VOXEL_OUTPUTS="voxel-outputs"
BUCKET_STL_MESHES="stl-meshes"
BUCKET_PREVIEWS="reconstruction-previews"

# AI Inference Config
SIMULATE_AI_DELAY_SECONDS=5.0
